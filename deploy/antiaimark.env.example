# /etc/antiaimark.env — environment for the systemd service.
# Copy to /etc/antiaimark.env and edit; every line is optional.

# --- service ---------------------------------------------------------------
# Bind address. Keep 127.0.0.1 unless behind a reverse proxy on a trusted
# network; set an API key before exposing further.
ANTIAIMARK_SERVER_HOST=127.0.0.1
ANTIAIMARK_SERVER_PORT=8765
# Require "Authorization: Bearer <key>" on every request (empty = no auth).
ANTIAIMARK_SERVER_API_KEY=
# Reported by /health and /capabilities.
ANTIAIMARK_SERVER_VERSION=

# --- UI language -------------------------------------------------------------
# en | zh | es | fr | ru (empty = follow system locale, default English)
ANTIAIMARK_LANG=

# --- background auto-clean ----------------------------------------------------
# 1 = enabled. When free disk space drops below the threshold (percent),
# stale wm-* temp dirs of this service are deleted oldest-first; expired
# downloads are evicted every interval regardless of disk space.
ANTIAIMARK_AUTO_CLEAN=0
ANTIAIMARK_AUTO_CLEAN_INTERVAL=15m
ANTIAIMARK_AUTO_CLEAN_THRESHOLD=11
ANTIAIMARK_AUTO_CLEAN_TTL=24h

# --- optional ML harness adapters (external checkouts) -----------------------
# ANTIAIMARK_NOAI_WATERMARK_DIR=        # CtrlRegen pixel removal
# ANTIAIMARK_MARKDIFFUSION_DIR=         # MarkDiffusion purification
# ANTIAIMARK_REVERSE_SYNTHID_DIR=       # reverse-SynthID scoring
# ANTIAIMARK_MARKLLM_DIR=               # MarkLLM text detection
