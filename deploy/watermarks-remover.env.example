# /etc/watermarks-remover.env — environment for the systemd service.
# Copy to /etc/watermarks-remover.env and edit; every line is optional.

# --- service ---------------------------------------------------------------
# Bind address. Keep 127.0.0.1 unless behind a reverse proxy on a trusted
# network; set an API key before exposing further.
WATERMARKS_SERVER_HOST=127.0.0.1
WATERMARKS_SERVER_PORT=8765
# Require "Authorization: Bearer <key>" on every request (empty = no auth).
WATERMARKS_SERVER_API_KEY=
# Reported by /health and /capabilities.
WATERMARKS_SERVER_VERSION=

# --- UI language -------------------------------------------------------------
# en | zh | es | fr | ru (empty = follow system locale, default English)
WATERMARKS_LANG=

# --- background auto-clean ----------------------------------------------------
# 1 = enabled. When free disk space drops below the threshold (percent),
# stale wm-* temp dirs of this service are deleted oldest-first; expired
# downloads are evicted every interval regardless of disk space.
WATERMARKS_AUTO_CLEAN=0
WATERMARKS_AUTO_CLEAN_INTERVAL=15m
WATERMARKS_AUTO_CLEAN_THRESHOLD=11
WATERMARKS_AUTO_CLEAN_TTL=24h

# --- optional ML harness adapters (external checkouts) -----------------------
# WATERMARKS_NOAI_WATERMARK_DIR=        # CtrlRegen pixel removal
# WATERMARKS_MARKDIFFUSION_DIR=         # MarkDiffusion purification
# WATERMARKS_REVERSE_SYNTHID_DIR=       # reverse-SynthID scoring
# WATERMARKS_MARKLLM_DIR=               # MarkLLM text detection
